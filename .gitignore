# Build and test output
node_modules/
*.tgz

# lib/client.js is deliberately NOT ignored.
#
# It is a generated artifact, but it is committed on purpose so that a git
# install works without a build step: pnpm refuses to run a git dependency's
# `prepare` script until the user allowlists it, and asking for that permission
# means asking them to run this package's code at install time. Shipping the
# built bundle avoids the request entirely.
#
# The readable source is lib/client.template.js, and `npm run build` regenerates
# the artifact deterministically from it, so the generated file is always
# reproducible from what is in the repository.

# Generated by `npm run test-page`.
test-page.html

